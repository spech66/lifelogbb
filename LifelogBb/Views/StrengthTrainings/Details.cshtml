@model LifelogBb.Models.Entities.StrengthTraining

@{
    ViewData["Title"] = "Strength Training";
    ViewData["Pretitle"] = "Details";
    ViewData["PrimaryAction"] = "create";
    ViewData["SecondaryAction"] = "graph";
}

<div class="container-xl">
    <div class="row row-cards">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Date)
                        </dt>
                        <dd class="col-sm-10">
                            @Model?.Date.ToString("yyyy-MM-dd")
                        </dd>
                        @if (Model?.TrainingPlanId != null)
                        {
                            <dt class="col-sm-2">Plan</dt>
                            <dd class="col-sm-10">
                                <a asp-controller="TrainingPlans" asp-action="Details" asp-route-id="@Model.TrainingPlanId">View plan</a>
                            </dd>
                        }
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Exercise)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Exercise)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Reps)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Reps)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Weight)
                        </dt>
                        <dd class="col-sm-10">
                            @(Model?.Weight?.ToString("0.##") ?? TrainingSetFormat.Empty)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.DurationSeconds)
                        </dt>
                        <dd class="col-sm-10">
                            @(Model?.DurationSeconds is int seconds ? TrainingSetFormat.FormatDuration(seconds) : TrainingSetFormat.Empty)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Notes)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Notes)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Rating)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Rating, "Rating")
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.CreatedAt)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.CreatedAt)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.UpdatedAt)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.UpdatedAt)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer text-end">
                    <div class="d-flex">
                        <a class="btn btn-secondary" asp-action="Index"><i class="fas fa-arrow-circle-left icon"></i>Back</a>
                        <a class="btn btn-danger ms-auto" asp-action="Delete" asp-route-id="@Model?.Id" role="button"><i class="fas fa-trash icon"></i> Delete</a>
                        <a class="btn btn-dark ms-auto" asp-action="Edit" asp-route-id="@Model?.Id" role="button"><i class="fas fa-pen icon"></i> Edit</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
